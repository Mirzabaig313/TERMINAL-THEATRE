# Keep LF line endings in every checkout, Windows included: the tests patch
# story files by exact text, and the stories built into the game stay
# byte-identical on every platform.
* text=auto eol=lf

# installers and scripts must keep their own line endings
*.sh text eol=lf
*.ps1 text eol=crlf

# binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.flac binary
